# --- MediMesh blockchain audit layer (local demonstration) ---
#
# Copy to .env.local and fill in the values printed by:
#   cd blockchain && npm run deploy
#
# NONE of these are secrets except BLOCKCHAIN_PRIVATE_KEY, which is a public
# Hardhat development key. Never reuse it outside a local chain and never fund
# it. It must NOT be prefixed with NEXT_PUBLIC_ or it would reach the browser.

# Local Hardhat node. Keep this on localhost — never expose a local RPC publicly.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Written to blockchain/deployments/local.json by the deploy script. Set this
# only if you need to point at a manifest in a different location.
# MEDIMESH_LEDGER_ADDRESS=0x...
# MEDIMESH_DEPLOYMENT_FILE=./blockchain/deployments/local.json

# Local demo signer. Generate your own with:
#   npx hardhat node   (accounts are printed on startup)
# Leave blank to run the app read-only with the blockchain panel showing
# "signer not configured".
BLOCKCHAIN_PRIVATE_KEY=

# --- Pointing at a public chain (optional) ---
#
# Base Sepolia is an EVM testnet with a free faucet, so the ledger can sit on a
# public chain instead of this laptop. Deploy with:
#
#   cd blockchain
#   BASE_SEPOLIA_RPC_URL=https://...  \
#   MM_DEPLOYER_PRIVATE_KEY=0x...     \
#   MM_CONFIRM_PUBLIC_DEPLOY=yes       \
#   npx hardhat run scripts/deploy-public.ts --network baseSepolia
#
# then point the app at the manifest it writes.
#
# BLOCKCHAIN_RPC_URL=https://sepolia.base.org
# BLOCKCHAIN_CHAIN_ID=84532
# MEDIMESH_DEPLOYMENT_FILE=./blockchain/deployments/baseSepolia.json
#
# The public deploy script writes NO private keys to disk. Each pharmacy signs
# its own settlements, so its key must be reachable somehow; this map is the
# stand-in for the KMS an operator would really use.
#
# {"0xYourPharmacyWallet": "0x...key..."}
# MM_WALLET_KEYS=
#
# Optional: refuse to deploy unless the key resolves to this address.
# MM_EXPECT_DEPLOYER=0x...

# Public origin used when encoding QR verification URLs. Defaults to the
# incoming request origin when unset.
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- MediMesh payments (Razorpay) ---
#
# Money is routed straight from the customer to the pharmacy owner's own linked
# Razorpay account; MediMesh retains only the platform fee. Bank details are
# entered on Razorpay's hosted onboarding page and are never stored here.
#
# With these unset the app falls back to a deterministic demo gateway, so the
# whole order -> pay -> settle -> on-chain-record flow runs offline. Setting only
# MM_RAZORPAY_KEY_SECRET enables the local demo checkout signature helper.
#
# Server-only. Must NOT be prefixed with NEXT_PUBLIC_.
MM_RAZORPAY_KEY_ID=
MM_RAZORPAY_KEY_SECRET=

# Used to verify the x-razorpay-signature header on /api/webhooks/razorpay.
# Required in production; without it webhooks are rejected.
MM_RAZORPAY_WEBHOOK_SECRET=

# The only payment value safe in the browser: Razorpay's publishable key id.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: block explorer used to link settlement receipts from the UI.
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# --- MediMesh notifications ---
#
# Job offers, rider assignments and refunds are announced here. Unset, messages
# print to the server terminal, which is what the demo uses. Set it to POST
# JSON { to, message } to a real SMS/WhatsApp gateway.
#
# Best-effort by design: a notification failure never fails the order it was
# describing. This is separate from the OTP channel on purpose — a failed OTP is
# a security problem, a failed "your rider is on the way" is an inconvenience.
# MM_SMS_ENDPOINT=
# MM_SMS_API_KEY=
