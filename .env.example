# --- MediMesh blockchain audit layer (local demonstration) ---
#
# Copy to .env.local and fill in the values printed by:
#   cd blockchain && npm run deploy
#
# NONE of these are secrets except BLOCKCHAIN_PRIVATE_KEY, which is a public
# Hardhat development key. Never reuse it outside a local chain and never fund
# it. It must NOT be prefixed with NEXT_PUBLIC_ or it would reach the browser.

# Local Hardhat node. Keep this on localhost — never expose a local RPC publicly.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Written to blockchain/deployments/local.json by the deploy script. Set this
# only if you need to point at a manifest in a different location.
# MEDIMESH_LEDGER_ADDRESS=0x...
# MEDIMESH_DEPLOYMENT_FILE=./blockchain/deployments/local.json

# Local demo signer. Generate your own with:
#   npx hardhat node   (accounts are printed on startup)
# Leave blank to run the app read-only with the blockchain panel showing
# "signer not configured".
BLOCKCHAIN_PRIVATE_KEY=

# --- Pointing at a public chain (optional) ---
#
# Base Sepolia is an EVM testnet with a free faucet, so the ledger can sit on a
# public chain instead of this laptop. Deploy with:
#
#   cd blockchain
#   BASE_SEPOLIA_RPC_URL=https://...  \
#   MM_DEPLOYER_PRIVATE_KEY=0x...     \
#   MM_CONFIRM_PUBLIC_DEPLOY=yes       \
#   npx hardhat run scripts/deploy-public.ts --network baseSepolia
#
# then point the app at the manifest it writes.
#
# BLOCKCHAIN_RPC_URL=https://sepolia.base.org
# BLOCKCHAIN_CHAIN_ID=84532
# MEDIMESH_DEPLOYMENT_FILE=./blockchain/deployments/baseSepolia.json
#
# The public deploy script writes NO private keys to disk. Each pharmacy signs
# its own settlements, so its key must be reachable somehow; this map is the
# stand-in for the KMS an operator would really use.
#
# {"0xYourPharmacyWallet": "0x...key..."}
# MM_WALLET_KEYS=
#
# Optional: refuse to deploy unless the key resolves to this address.
# MM_EXPECT_DEPLOYER=0x...

# Public origin used when encoding QR verification URLs. Defaults to the
# incoming request origin when unset.
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- MediMesh payments (Razorpay) ---
#
# Money is routed straight from the customer to the pharmacy owner's own linked
# Razorpay account; MediMesh retains only the platform fee. Bank details are
# entered on Razorpay's hosted onboarding page and are never stored here.
#
# With these unset the app falls back to a deterministic demo gateway, so the
# whole order -> pay -> settle -> on-chain-record flow runs offline. Setting only
# MM_RAZORPAY_KEY_SECRET enables the local demo checkout signature helper.
#
# Server-only. Must NOT be prefixed with NEXT_PUBLIC_.
MM_RAZORPAY_KEY_ID=
MM_RAZORPAY_KEY_SECRET=

# Used to verify the x-razorpay-signature header on /api/webhooks/razorpay.
# Required in production; without it webhooks are rejected.
MM_RAZORPAY_WEBHOOK_SECRET=

# The only payment value safe in the browser: Razorpay's publishable key id.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: block explorer used to link settlement receipts from the UI.
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# --- MediMesh notifications ---
#
# Job offers, rider assignments and refunds are announced here. Unset, messages
# print to the server terminal, which is what the demo uses. Set it to POST
# JSON { to, message } to a real SMS/WhatsApp gateway.
#
# Best-effort by design: a notification failure never fails the order it was
# describing. This is separate from the OTP channel on purpose — a failed OTP is
# a security problem, a failed "your rider is on the way" is an inconvenience.
# MM_SMS_ENDPOINT=
# MM_SMS_API_KEY=

# --- Database ---
#
# Required. Every page that shows data reads this, so there is no useful way to
# run the app without it. Three names are accepted in this order:
#   DATABASE_URL, SUPABASE_DB_URL, POSTGRES_URL
#   then a local fallback of postgresql://localhost/medimesh
#
# Local development
# -----------------
# DATABASE_URL=postgresql://localhost/medimesh
#
# Deployment (Supabase, or any managed Postgres)
# ---------------------------------------------
# Use the **pooler** connection string, not the direct one:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Port 6543 (transaction pooler) is the one that matters on a serverless host.
# The direct connection (port 5432) will appear to work and then cost you seconds
# per request, because every new connection does a full TLS handshake from
# Mumbai to wherever the database lives. Measured on this app's deployment: a
# page with no database queries answered in ~0.5s, and the same page with four
# queries took 4-5s. That gap is connection setup, not query cost — the whole
# catalogue is 123 medicines and 180 stock rows.
#
# DATABASE_SSL
# ------------
# DATABASE_SSL=true
#
# Required for Supabase and for any hosted database. Unset locally: local Postgres
# over TCP does not want TLS, and turning it on fails the connection outright.
#
# DB_POOL_MAX
# -----------
# Defaults to 10. Keep it small on a serverless host — every warm instance keeps
# its own pool open, and a transaction pooler plus a large per-instance pool is
# how you exhaust a free tier's connection limit.
# DB_POOL_MAX=10
#
# MM_FORCE_SCHEMA
# ---------------
# The schema is applied automatically when it differs from what the database
# already has, and skipped otherwise — checked with one cheap query, because
# applying 31 CREATE TABLEs and 106 index statements on every cold start is
# expensive enough to be felt. Editing lib/schema.sql changes its fingerprint, so
# the next cold start applies it.
#
# Set to 1 to force a re-apply when you need to. Only needed if the fingerprint
# is somehow correct while the schema is not.
# MM_FORCE_SCHEMA=1

# --- Sessions & secrets (required in production) ---
#
# Generate with:  openssl rand -hex 32
# SESSION_PEPPER=
#
# APP_ENCRYPTION_KEY=
#
# These two have no safe default. The app refuses to start in production without
# them rather than inventing a value, because a hardcoded fallback would mean one
# shared secret across every deployment.
#
# MM_ALLOW_DEV_KEYS
# -----------------
# Permits the development encryption keys that the test suite uses. Refused in
# production.
# MM_ALLOW_DEV_KEYS=1

# --- Public demo sign-in (opt-in) ---
#
# A deployed link with nothing behind it is not much of a demo. These two
# together allow one-tap sign-in on a public deployment. Both are required and
# the second must be that exact string, so a stray env var cannot expose every
# seeded persona on a public URL.
#
#   MM_DEMO_LOGIN_PROD=1
#   MM_ALLOW_DEMO_LOGIN_IN_PROD=I_UNDERSTAND_THIS_IS_PUBLIC
#
# This is deliberately NOT the same switch as DEMO_MODE. DEMO_MODE also controls
# revealed OTPs and SMS printed to the server log; setting it in production to
# get the sign-in buttons would arm all of those. Put only seeded demo data in a
# deployment that has these set.
#
# MM_DEMO_LOGIN_PROD=
# MM_ALLOW_DEMO_LOGIN_IN_PROD=

# --- AI assistant (optional) ---
#
# Unset all four and the assistant runs entirely locally: no key, no network, no
# account. A provider may only reword an answer; it cannot decide emergencies,
# name a medicine, give a dose, or drop the referral, and its output is rejected
# if it tries. Any failure falls back to the local answer unchanged.
#
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# MM_ASSISTANT_PROVIDER_URL=
# MM_ASSISTANT_PROVIDER_KEY=
# MM_ASSISTANT_PROVIDER_MODEL=
# MM_ASSISTANT_PROVIDER_TIMEOUT_MS=8000

# --- Identity verification (optional) ---
#
# Leave blank and the app uses a deterministic local stand-in for KYC so the
# verification flow is demonstrable offline.
# MM_KYC_ENDPOINT=
# MM_KYC_API_KEY=
